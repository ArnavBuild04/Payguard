# Copy this file to .env and fill in your own key. Leaving GEMINI_API_KEY blank makes the
# agent run entirely on the deterministic fake LLM and fake embeddings (no external calls,
# no cost) -- fine for running the tests and the demo.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=text-embedding-004

CORE_BASE_URL=http://localhost:8080

DB_HOST=localhost
DB_PORT=5432
DB_USER=payguard
DB_PASSWORD=payguard
DB_NAME=payguard

HTTP_PORT=8090
